<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <!-- Toolbar minimal -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:title="Add Player"
        android:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_close"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Card contenedor -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAddPlayer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_background"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Nombre -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Player Name"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeColor="@color/primary_button">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"/>

            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp"/>

            <!-- Selector de rol -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Position"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/radioGroupRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioGoalkeeper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Goalkeeper"
                    android:textColor="@color/text_primary"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioField"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Field Player"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="32dp"
                    android:checked="true"/>

            </RadioGroup>

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp"/>

            <!-- Botón Crear -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCreate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CREATE PLAYER"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/primary_button_text"
                app:backgroundTint="@color/primary_button"
                app:cornerRadius="28dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>